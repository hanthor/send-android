<?xml version="1.0" encoding="utf-8"?>
<!-- Direct share: long-lived conversation shortcuts carrying this category (MessageNotifier) appear as targets in
     the system share sheet; choosing one starts ShareActivity with EXTRA_SHORTCUT_ID = the room ID. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="dev.send.matrix.ShareActivity">
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="*/*" />
        <category android:name="dev.send.matrix.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
